{
  "name": "playwright-cli",
  "version": "0.1.0",
  "description": "CLI tool for Playwright browser automation - Fork of microsoft/playwright-cli",
  "main": "lib/index.js",
  "bin": {
    "playwright-cli": "lib/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rm -rf lib",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "playwright",
    "cli",
    "browser",
    "automation",
    "testing"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "playwright-core": "^1.40.0",
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/playwright-cli.git"
  },
  "jest": {
    "testTimeout": 60000,
    "verbose": true,
    "testPathPattern": "src/__tests__"
  }
}
